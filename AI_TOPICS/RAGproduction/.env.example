# Required
OPENAI_API_KEY=sk-your-key-here

# Optional API protection for POST /v1/ingest
# API_KEY=change-me

# Models & retrieval
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0
RETRIEVER_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Paths (overridden in docker-compose to /app/data and /app/chroma_db)
DATA_DIR=../data
CHROMA_DIR=../rag_chroma_db
CHROMA_COLLECTION=books
# Skip CSV by default — Sentiment_train.csv alone is ~32k rows and triggers 429s
INGEST_EXTENSIONS=.pdf,.txt

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_NAME=RAG Production API
APP_VERSION=1.0.0
